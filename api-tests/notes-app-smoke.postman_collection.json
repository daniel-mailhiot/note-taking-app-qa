    {
      "name": "Auth",
      "item": [
        {
          "name": "POST Register new user (TC-001)",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "// Make the register request idempotent so the smoke suite is rerunnable.\r",
                  "// Each run generates a fresh username by appending a short timestamp.\r",
                  "const base = pm.environment.get(\"testUsername\") || \"qa_postman_user\";\r",
                  "// Strip any prior suffix so they do not accumulate (_123_456_789).\r",
                  "const clean = base.replace(/_\\d{6,}$/, \"\");\r",
                  "const stamped = `${clean}_${Date.now()}`;\r",
                  "pm.environment.set(\"testUsername\", stamped);\r",
                  "console.log(\"Register will use username:\", stamped);"
                ],
                "type": "text/javascript",
                "packages": {},
                "requests": {}
              }
            },
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"TC-001 Status is 302 Found\", function () {\r",
                  "    pm.response.to.have.status(302)\r",
                  "});\r",
                  "\r",
                  "pm.test(\"TC-001 Location header redirects to /notes\", function () {\r",
                  "    pm.expect(pm.response.headers.get(\"Location\")).to.eql(\"/notes\")\r",
                  "});\r",
                  "\r",
                  "pm.test(\"TC-001 Set-Cookie contains connect.sid\", function () {\r",
                  "    const setCookie = pm.response.headers.get(\"Set-Cookie\") || \"\"\r",
                  "    pm.expect(setCookie).to.include(\"connect.sid\")\r",
                  "});"
                ],
                "type": "text/javascript",
                "packages": {},
                "requests": {}
              }
            }
          ],
          "protocolProfileBehavior": {
            "followRedirects": false
          },
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "urlencoded",
              "urlencoded": [
                {
                  "key": "username",
                  "value": "{{testUsername}}",
                  "type": "text",
                  "uuid": "da5ed9d6-31a7-4401-9a2a-9087c08b9650"
                },
                {
                  "key": "password",
                  "value": "{{testPassword}}",
                  "type": "text",
                  "uuid": "faf19611-a805-49de-99a4-2fa7682f9ef1"
                }
              ]
            },
            "url": {
              "raw": "{{baseURL}}/auth/register",
              "host": [
                "{{baseURL}}"
              ],
              "path": [
                "auth",
                "register"
              ]
            },
            "description": "Manual test case: TC-001\n\nRegisters a new user. Expected 302 redirect to /notes and Set-Cookie: connect.sid on success."
          },
          "response": []
        },
