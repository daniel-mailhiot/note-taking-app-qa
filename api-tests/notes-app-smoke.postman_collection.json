    {
      "name": "Notes",
      "item": [
        {
          "name": "POST Create note (TC-008)",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "// Generate a fresh title and content for every Create run so reruns stay clean and each note is easy to identify in the DB or UI.\r",
                  "const stamp = Date.now();\r",
                  "pm.environment.set(\"testNoteTitle\", `QA Smoke Note ${stamp}`);\r",
                  "pm.environment.set(\"testNoteContent\", `Created by Postman at ${new Date(stamp).toISOString()}`);\r",
                  "console.log(\"Create will use title:\", pm.environment.get(\"testNoteTitle\"));"
                ],
                "type": "text/javascript",
                "packages": {},
                "requests": {}
              }
            },
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"TC-008 Status is 200 OK\", function () {\r",
                  "    pm.response.to.have.status(200)\r",
                  "});\r",
                  "\r",
                  "pm.test(\"TC-008 Response HTML contains the newly created title\", function () {\r",
                  "    const title = pm.environment.get(\"testNoteTitle\")\r",
                  "    pm.expect(pm.response.text()).to.include(title)\r",
                  "});\r",
                  "\r",
                  "// The app is EJS rendered, so POST /notes returns the full HTML notes list instead of a JSON object with an ID. Parse the first /notes/<id>/edit link out of the HTML, which is the newest note because listNotes sorts newest-first.\r",
                  "pm.test(\"TC-008 New note ID is captured into environment\", function () {\r",
                  "    const body = pm.response.text()\r",
                  "    const match = body.match(/\\/notes\\/([a-f0-9]{24})\\/edit/)\r",
                  "    pm.expect(match, \"expected at least one /notes/<id>/edit link in the HTML response\").to.not.be.null\r",
                  "    pm.environment.set(\"noteId\", match[1])\r",
                  "    console.log(\"Captured noteId:\", match[1])\r",
                  "});"
                ],
                "type": "text/javascript",
                "packages": {},
                "requests": {}
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "urlencoded",
              "urlencoded": [
                {
                  "key": "title",
                  "value": "{{testNoteTitle}}",
                  "type": "text",
                  "uuid": "9a2198fe-5c59-4bb3-95aa-a55bba0902fb"
                },
                {
                  "key": "content",
                  "value": "{{testNoteContent}}",
                  "type": "text",
                  "uuid": "65451ab4-19be-46f0-aa2e-9ad6aba94da9"
                }
              ]
            },
            "url": {
              "raw": "{{baseURL}}/notes",
              "host": [
                "{{baseURL}}"
              ],
              "path": [
                "notes"
              ]
            },
            "description": "Manual test case: TC-008\n\nCreates a new note for the logged in user. Expected 200 OK with the new title rendered in the returned notes list HTML on success. Post-response script captures the new note's ID into {{noteId}} so the Update and Delete requests can reference it."
          },
          "response": []
        },
