    {
      "name": "Negative",
      "item": [
        {
          "name": "POST /notes with whitespace-only fields (TC-012, BUG-002)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "// Pinned to current buggy behavior by design so Newman stays green. When BUG-002 is fixed this test will go red, which is the signal to flip the assertions to the expected 400 with a validation message. Full context: docs/bugs/BUG-002-whitespace-validation-500.md\r",
                  "pm.test(\"TC-012 (BUG-002) Whitespace fields currently return 500 (known bug)\", function () {\r",
                  "    pm.response.to.have.status(500)\r",
                  "});\r",
                  "\r",
                  "pm.test(\"TC-012 (BUG-002) Response body indicates a server error rather than a validation error\", function () {\r",
                  "    pm.expect(pm.response.text()).to.include(\"Failed to create note\")\r",
                  "});"
                ],
                "type": "text/javascript",
                "packages": {},
                "requests": {}
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "urlencoded",
              "urlencoded": [
                {
                  "key": "title",
                  "value": " ",
                  "type": "text",
                  "uuid": "10582c3c-f7d1-4689-83ed-3fe7cd4cb40e"
                },
                {
                  "key": "content",
                  "value": " ",
                  "type": "text",
                  "uuid": "ecfd238a-9a2a-4d04-99a5-802192d7a098"
                }
              ]
            },
            "url": {
              "raw": "{{baseURL}}/notes",
              "host": [
                "{{baseURL}}"
              ],
              "path": [
                "notes"
              ]
            },
            "description": "Manual test case: TC-012 (validation rejects whitespace-only note fields)  \nRelated defect: BUG-002\n\nSends a single space in both title and content. Runs first in the Negative folder so it inherits the live session from Notes CRUD, which the middleware requires before the controller's whitespace handling runs.\n\nCurrent behavior: 500 with a generic error (BUG-002 open).  \nExpected when fixed: 400 with a clear validation message.\n\nFull details: docs/bugs/BUG-002-whitespace-validation-500.md"
          },
          "response": []
        },
        {
          "name": "POST Login with invalid credentials (TC-005)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"TC-005 Status is 401 Unauthorized\", function () {\r",
                  "    pm.response.to.have.status(401);\r",
                  "});\r",
                  "\r",
                  "pm.test(\"TC-005 Response body shows 'Invalid username or password'\", function () {\r",
                  "    pm.expect(pm.response.text()).to.include(\"Invalid username or password\");\r",
                  "});\r",
                  "\r",
                  "pm.test(\"TC-005 No new session cookie is issued on failed login\", function () {\r",
                  "    const setCookie = pm.response.headers.get(\"Set-Cookie\") || \"\";\r",
                  "    pm.expect(setCookie).to.not.include(\"connect.sid\");\r",
                  "});"
                ],
                "type": "text/javascript",
                "packages": {},
                "requests": {}
              }
            },
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "// Strip any session cookie before sending so the invalid login request runs as an unauthenticated user even if Login ran earlier.\r",
                  "const jar = pm.cookies.jar();\r",
                  "jar.clear(pm.environment.get(\"baseURL\"), function (err) {\r",
                  "    if (err) {\r",
                  "        console.log(\"Cookie clear error:\", err);\r",
                  "    } else {\r",
                  "        console.log(\"Cleared cookies before sending invalid login request.\");\r",
                  "    }\r",
                  "});"
                ],
                "type": "text/javascript",
                "packages": {},
                "requests": {}
              }
            }
          ],
          "protocolProfileBehavior": {
            "followRedirects": false
          },
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "urlencoded",
              "urlencoded": [
                {
                  "key": "username",
                  "value": "{{testUsername}}",
                  "type": "text",
                  "uuid": "54247a5e-381b-4855-b880-f5f9352c9d69"
                },
                {
                  "key": "password",
                  "value": "wrongpassword",
                  "type": "text",
                  "uuid": "cbe61842-ff96-4585-85f7-dffa4773d367"
                }
              ]
            },
            "url": {
              "raw": "{{baseURL}}/auth/login",
              "host": [
                "{{baseURL}}"
              ],
              "path": [
                "auth",
                "login"
              ]
            },
            "description": "Manual test case: TC-005 (login with wrong password returns 401 and no session cookie)\n\nSends a valid existing username (created by POST Register new user in the same run) with a deliberately wrong password.\n\nExpected behavior: 401 Unauthorized with login page re-rendered containing \"Invalid username or password\" and no new connect.sid cookie.  \nCurrent behavior: matches expected (TC-005 passed in TR-001)."
          },
          "response": []
        },
